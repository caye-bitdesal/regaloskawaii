---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import ProductDetailHeader from '../components/ProductDetailHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title?: string;
  description?: string;
  headerVariant?: 'full' | 'minimal';
  pathname?: string;
  hideSearch?: boolean;
}

const {
  title = 'Regalos Kawaii',
  description = 'Una selección de cosas bonitas encontradas por internet.',
  headerVariant = 'full',
  pathname = Astro.url.pathname,
  hideSearch = false,
} = Astro.props;

const fullTitle = title.includes('Regalos Kawaii') ? title : `${title} | Regalos Kawaii`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
  </head>
  <body>
    {
      headerVariant === 'minimal' ? (
        <ProductDetailHeader />
      ) : (
        <SiteHeader pathname={pathname} hideSearch={hideSearch} />
      )
    }
    <main>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
