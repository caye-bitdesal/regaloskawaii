---
import SiteLayout from '../layouts/SiteLayout.astro';
import CategoryCard from '../components/CategoryCard.astro';
import FilterChips from '../components/FilterChips.astro';
import ProductGrid from '../components/ProductGrid.astro';
import ProductCard from '../components/ProductCard.astro';
import RkIcon from '../components/RkIcon.astro';
import { getCatalog } from '../lib/catalog';

const catalog = await getCatalog();
const collectionsWithProducts = catalog.collections.filter((c) => c.productIds.length > 0);
const chips = [
  { id: 'all', label: 'Todas' },
  ...collectionsWithProducts.map((c) => ({ id: c.slug, label: c.title })),
];
---

<SiteLayout
  pathname="/colecciones"
  title="Colecciones"
  description="Selecciones kawaii por precio, estilo y tendencias."
>
  <section class="page-intro categories-intro">
    <div class="shell">
      <span class="eyebrow"><RkIcon name="sparkle" /> Curadas a mano</span>
      <h1>Nuestras <em>colecciones</em></h1>
      <p>
        Listas hechas con mimo: por precio, por vibe viral o por temática. Cada bloque muestra los
        productos de esa colección.
      </p>
    </div>
  </section>

  <section class="catalog shell">
    <div class="section-heading">
      <div>
        <span class="eyebrow">Explora a tu manera</span>
        <h2>Un universo para cada gusto</h2>
      </div>
      <p>Ideas ordenadas para encontrar justo lo que buscas</p>
    </div>
    {chips.length > 1 && (
      <FilterChips chips={chips} gridId="collection-blocks-list" collectionBlocks />
    )}
    <div class="category-showcase" style="margin-bottom: 2rem;">
      {collectionsWithProducts.map((col, i) => (
        <CategoryCard
          href={`#coleccion-${col.slug}`}
          title={col.title}
          productCount={col.productIds.length}
          index={i}
        />
      ))}
    </div>
    <div id="collection-blocks-list" class="collection-blocks">
    {
      collectionsWithProducts.map((col) => {
        const products = catalog.products.filter((p) => p.coleccionSlugs.includes(col.slug));
        return (
          <article class="collection-block" id={`coleccion-${col.slug}`} data-collection={col.slug}>
            <div class="collection-block-header">
              <div>
                <span class="eyebrow">Colección</span>
                <h2>
                  <a href={`/coleccion/${col.slug}`}>{col.title}</a>
                </h2>
                {col.descripcion && <p>{col.descripcion}</p>}
              </div>
              <a class="primary collection-block-link" href={`/coleccion/${col.slug}`}>
                Ver solo esta colección
                <RkIcon name="arrow" />
              </a>
            </div>
            <ProductGrid>
              {products.map((p) => (
                <ProductCard product={p} />
              ))}
            </ProductGrid>
          </article>
        );
      })
    }
    </div>
  </section>
</SiteLayout>

<script>
  document
    .querySelectorAll<HTMLAnchorElement>('.category-showcase a.category-tile[href^="#coleccion-"]')
    .forEach((link) => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const slug = link.getAttribute('href')?.replace(/^#coleccion-/, '');
        if (!slug) return;
        const btn = document.querySelector<HTMLButtonElement>(
          `#filter-chips button[data-filter="${slug}"]`,
        );
        btn?.click();
        document.getElementById(`coleccion-${slug}`)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });
</script>
