---
import SiteLayout from '../layouts/SiteLayout.astro';
import ProductGrid from '../components/ProductGrid.astro';
import ProductCard from '../components/ProductCard.astro';
import RkIcon from '../components/RkIcon.astro';
import { getCatalog } from '../lib/catalog';

const catalog = await getCatalog();
const chollosCol = catalog.collectionsBySlug['chollos'];
let products = chollosCol
  ? catalog.products.filter((p) => p.coleccionSlugs.includes('chollos'))
  : catalog.products.filter((p) => p.destacado);
---

<SiteLayout pathname="/chollos" title="Chollos kawaii" description="Ofertas y hallazgos kawaii a buen precio." hideSearch>
  <section class="deals-hero">
    <div class="shell deals-hero-inner">
      <div>
        <span class="eyebrow"><RkIcon name="sparkle" /> Precios para sonreír</span>
        <h1>Chollos muy <em>kawaii</em></h1>
        <p>
          Una selección especial de oportunidades bonitas. Los precios pueden cambiar en la tienda de
          destino, así que no los dejes escapar.
        </p>
      </div>
      <div class="deal-bubble">
        <strong>Hasta</strong>
        <span>−40%</span>
        <small>en nuestra selección</small>
      </div>
    </div>
  </section>

  <section class="catalog shell deals-catalog">
    <div class="section-heading">
      <div>
        <span class="eyebrow">Actualizado recientemente</span>
        <h2>Pequeños precios, grandes hallazgos</h2>
      </div>
      <p>{products.length} chollos disponibles</p>
    </div>
    <div class="deal-notice">
      <RkIcon name="sparkle" />
      <p>
        <strong>Te llevamos a la oferta.</strong> Regalos Kawaii no procesa compras y el precio final
        siempre será el mostrado por la tienda externa.
      </p>
    </div>
    <ProductGrid>
      {products.map((p, i) => (
        <ProductCard product={p} variant="deal" dealIndex={i} />
      ))}
    </ProductGrid>
  </section>
</SiteLayout>
