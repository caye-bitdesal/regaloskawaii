---
import SiteLayout from '../layouts/SiteLayout.astro';
import CategoryCard from '../components/CategoryCard.astro';
import RkIcon from '../components/RkIcon.astro';
import { getCatalog } from '../lib/catalog';

const catalog = await getCatalog();
---

<SiteLayout pathname="/marcas" title="Marcas" description="Regalos kawaii por marca.">
  <section class="page-intro categories-intro">
    <div class="shell">
      <span class="eyebrow"><RkIcon name="sparkle" /> Oficiales y favoritas</span>
      <h1>Explora por <em>marca</em></h1>
      <p>Sanrio, Pop Mart y otras marcas que amamos, con los productos que tenemos indexados.</p>
    </div>
  </section>

  <section class="categories-section">
    <div class="shell">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Explora a tu manera</span>
          <h2>Un universo para cada gusto</h2>
        </div>
        <p>Ideas ordenadas para encontrar justo lo que buscas</p>
      </div>
      <div class="category-showcase">
        {catalog.brands.map((brand, i) => (
          <CategoryCard
            href={`/marca/${brand.slug}`}
            title={brand.label}
            productCount={brand.productIds.length}
            index={i}
          />
        ))}
      </div>
    </div>
  </section>
</SiteLayout>
