---
import SiteLayout from '../layouts/SiteLayout.astro';
import HowItWorksSection from '../components/HowItWorksSection.astro';
import RkIcon from '../components/RkIcon.astro';
import { getCatalog } from '../lib/catalog';

const catalog = await getCatalog();
const imgs = catalog.products.filter((p) => p.imagenUrl).slice(0, 2);
const aboutMain =
  imgs[0]?.imagenUrl ??
  'https://images.unsplash.com/photo-1741241857658-7ce76d565ed7?auto=format&fit=crop&w=900&q=85';
const aboutSmall =
  imgs[1]?.imagenUrl ??
  'https://images.unsplash.com/photo-1747999613041-48827741ddda?auto=format&fit=crop&w=900&q=85';
---

<SiteLayout pathname="/sobre-nosotros" title="Sobre nosotros" description="Conoce Regalos Kawaii." hideSearch>
  <section class="page-intro about-intro">
    <div class="shell">
      <span class="eyebrow"><RkIcon name="heart" /> Nuestra pequeña historia</span>
      <h1>Compartimos cosas que nos hacen <em>sonreír</em></h1>
      <p>
        Regalos Kawaii nació para hacer más fácil encontrar detalles originales y bonitos sin perderse
        entre miles de opciones.
      </p>
    </div>
  </section>

  <section class="about shell" id="about">
    <div class="about-images">
      <img class="about-main" src={aboutMain} alt="Selección de pequeños accesorios kawaii" width="800" height="470" />
      <img class="about-small" src={aboutSmall} alt="Figura kawaii seleccionada" width="400" height="220" />
      <span class="about-note">Hallazgos con encanto</span>
    </div>
    <div class="about-copy">
      <span class="eyebrow">Sobre Regalos Kawaii</span>
      <h2>Buscamos lo bonito para que tú no tengas que hacerlo</h2>
      <p>
        Recorremos tiendas y marketplaces para reunir regalos originales, adorables y con ese punto
        especial que hace sonreír.
      </p>
      <p>
        No vendemos productos ni gestionamos pedidos. Somos una guía independiente: cuando algo te
        enamora, te llevamos directamente a la tienda donde lo hemos encontrado.
      </p>
      <div class="about-values">
        <div>
          <strong>Selección cuidada</strong>
          <span>Solo cosas que regalaríamos.</span>
        </div>
        <div>
          <strong>Enlaces directos</strong>
          <span>Sin carritos ni complicaciones.</span>
        </div>
      </div>
      <a class="primary" href="/chollos">
        Descubrir los chollos
        <RkIcon name="arrow" />
      </a>
    </div>
  </section>

  <HowItWorksSection />
</SiteLayout>
