---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ProductDetailPanel from '../../components/ProductDetailPanel.astro';
import RelatedProducts from '../../components/RelatedProducts.astro';
import RkIcon from '../../components/RkIcon.astro';
import { getCatalog } from '../../lib/catalog';

export async function getStaticPaths() {
  const catalog = await getCatalog();
  return catalog.products.map((p) => ({
    params: { slug: p.slug },
    props: { productSlug: p.slug },
  }));
}

const { productSlug } = Astro.props;
const catalog = await getCatalog();
const product = catalog.productsBySlug[productSlug as string];
if (!product) throw new Error(`Producto no encontrado: ${productSlug}`);

const primaryCol = product.coleccionSlugs[0];
const related = catalog.products
  .filter((p) => p.slug !== product.slug && primaryCol && p.coleccionSlugs.includes(primaryCol))
  .slice(0, 3);

const seoTitle = product.seo?.title ?? product.title;
const seoDesc = product.seo?.description ?? product.resumen;
---

<SiteLayout headerVariant="minimal" title={seoTitle} description={seoDesc ?? product.resumen}>
  <section class="detail shell">
    <a class="back mobile-back" href="/">
      <RkIcon name="back" /> Volver
    </a>
    <div class="detail-image">
      {
        product.imagenUrl ? (
          <img src={product.imagenUrl} alt={product.imagenAlt ?? product.title} width="800" height="570" />
        ) : (
          <span class="meta" style="display:grid;place-items:center;height:100%;">Sin imagen</span>
        )
      }
      <span class="detail-sticker">Selección kawaii</span>
    </div>
    <ProductDetailPanel product={product} />
  </section>
  <RelatedProducts products={related} />
</SiteLayout>
