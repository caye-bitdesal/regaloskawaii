---
import SiteLayout from '../../layouts/SiteLayout.astro';
import FilterChips from '../../components/FilterChips.astro';
import ProductGrid from '../../components/ProductGrid.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getCatalog, sortProducts } from '../../lib/catalog';
import { HOME_CRUMB, crumb } from '../../lib/seo/breadcrumbs';
import { itemListJsonLd, MIN_CATEGORY_PRODUCTS_FOR_INDEX } from '../../lib/seo/jsonLd';

export async function getStaticPaths() {
  const catalog = await getCatalog();
  return catalog.allCategories.map((cat) => ({
    params: { slug: cat.slug },
    props: { categorySlug: cat.slug },
  }));
}

const { categorySlug } = Astro.props;
const catalog = await getCatalog();
const category = catalog.categoriesBySlug[categorySlug as string];
if (!category) throw new Error(`Categoría no encontrada: ${categorySlug}`);

// Incluye los productos de sus subcategorías.
const ids = new Set(category.productIds);
const products = sortProducts(catalog.products.filter((p) => ids.has(p.id)));

const parent = category.parentSlug ? catalog.categoriesBySlug[category.parentSlug] : undefined;
// En una subcategoría se muestran sus hermanas, para poder saltar de una a otra.
const subcategories = parent ? parent.children : category.children;
const subcategoryBase = parent ?? category;

const collectionSlugsInView = new Set<string>();
for (const p of products) {
  for (const slug of p.coleccionSlugs) collectionSlugsInView.add(slug);
}

const chips = [
  { id: 'all', label: 'Todas' },
  ...catalog.collections
    .filter((c) => collectionSlugsInView.has(c.slug))
    .map((c) => ({ id: c.slug, label: c.title })),
];

const siteOrigin = Astro.site ?? new URL('https://regaloskawaii.es');
const categoryBreadcrumbs = [HOME_CRUMB, crumb('Categorías', '/categorias')];
if (parent) categoryBreadcrumbs.push(crumb(parent.label, `/categoria/${parent.slug}`));
categoryBreadcrumbs.push(crumb(category.label, `/categoria/${category.slug}`));

const categoryDescription = parent
  ? `${category.label} kawaii: ideas de regalo de ${parent.label.toLowerCase()}.`
  : `Regalos kawaii de ${category.label.toLowerCase()}.`;
---

<SiteLayout
  pathname={`/categoria/${category.slug}`}
  title={category.label}
  description={categoryDescription}
  breadcrumbs={categoryBreadcrumbs}
  noindex={products.length < MIN_CATEGORY_PRODUCTS_FOR_INDEX}
  jsonLd={products.length > 0 ? [itemListJsonLd(products, siteOrigin)] : []}
>
  <section class="page-intro categories-intro">
    <div class="shell">
      {
        parent ? (
          <a class="eyebrow" href={`/categoria/${parent.slug}`}>← {parent.label}</a>
        ) : (
          <span class="eyebrow">{category.label}</span>
        )
      }
      <h1 set:html={category.label.includes(' ') ? category.label : `<em>${category.label}</em>`} />
      <p>
        {products.length}{' '}
        {products.length === 1 ? 'producto en esta categoría' : 'productos en esta categoría'}
      </p>
    </div>
  </section>

  <section class="catalog shell">
    {
      subcategories.length > 0 && (
        <>
          <div class="section-heading">
            <div>
              <h2>Tipos de {subcategoryBase.label.toLowerCase()}</h2>
            </div>
          </div>
          <nav class="category-row subcategory-row" aria-label={`Tipos de ${subcategoryBase.label}`}>
            <a href={`/categoria/${subcategoryBase.slug}`} class:list={['category', !parent && 'active']}>
              Todo
            </a>
            {subcategories.map((sub) => (
              <a
                href={`/categoria/${sub.slug}`}
                class:list={['category', sub.slug === category.slug && 'active']}
                aria-current={sub.slug === category.slug ? 'page' : undefined}
              >
                {sub.label} <small>({sub.count})</small>
              </a>
            ))}
          </nav>
        </>
      )
    }
    {
      chips.length > 1 && (
        <>
          <div class="section-heading" style={subcategories.length > 0 ? 'margin-top: 1.5rem;' : undefined}>
            <div>
              <h2>Filtrar por colección</h2>
            </div>
          </div>
          <FilterChips chips={chips} urlSync />
        </>
      )
    }
    <div class="section-heading" style="margin-top: 1.5rem;">
      <div>
        <h2>Productos</h2>
      </div>
    </div>
    {
      products.length > 0 ? (
        <ProductGrid>
          {products.map((p) => (
            <ProductCard product={p} />
          ))}
        </ProductGrid>
      ) : (
        <div class="empty">
          <p>Aún no hay productos en esta categoría.</p>
        </div>
      )
    }
  </section>
</SiteLayout>

<script>
  // En móvil, que se vea la subcategoría activa aunque esté al final de la fila.
  document
    .querySelector('.subcategory-row [aria-current="page"]')
    ?.scrollIntoView({ block: 'nearest', inline: 'center' });
</script>
