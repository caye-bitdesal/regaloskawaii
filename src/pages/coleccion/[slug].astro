---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ProductGrid from '../../components/ProductGrid.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getCatalog } from '../../lib/catalog';

export async function getStaticPaths() {
  const catalog = await getCatalog();
  return catalog.collections.map((col) => ({
    params: { slug: col.slug },
    props: { collectionSlug: col.slug },
  }));
}

const { collectionSlug } = Astro.props;
const catalog = await getCatalog();
const collection = catalog.collectionsBySlug[collectionSlug as string];
if (!collection) throw new Error(`Colección no encontrada: ${collectionSlug}`);

const products = catalog.products.filter((p) => p.coleccionSlugs.includes(collection.slug));
---

<SiteLayout
  pathname={`/coleccion/${collection.slug}`}
  title={collection.title}
  description={collection.descripcion}
>
  <section class="page-intro categories-intro">
    <div class="shell">
      <span class="eyebrow">{collection.title}</span>
      <h1 set:html={collection.title.includes(' ') ? collection.title : `<em>${collection.title}</em>`} />
      {collection.descripcion && <p>{collection.descripcion}</p>}
    </div>
  </section>

  <section class="catalog shell">
    <div class="section-heading">
      <div>
        <h2>Productos en esta colección</h2>
      </div>
      <p>
        {products.length} {products.length === 1 ? 'producto' : 'productos'}
      </p>
    </div>
    {
      products.length > 0 ? (
        <ProductGrid>
          {products.map((p) => (
            <ProductCard product={p} />
          ))}
        </ProductGrid>
      ) : (
        <div class="empty">
          <p>Aún no hay productos en esta colección.</p>
        </div>
      )
    }
  </section>
</SiteLayout>
