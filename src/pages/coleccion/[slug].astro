---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ProductGrid from '../../components/ProductGrid.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getCatalog } from '../../lib/catalog';

export async function getStaticPaths() {
  const catalog = await getCatalog();
  return catalog.collections.map((col) => ({
    params: { slug: col.slug },
    props: { collectionSlug: col.slug },
  }));
}

const { collectionSlug } = Astro.props;
const catalog = await getCatalog();
const collection = catalog.collectionsBySlug[collectionSlug as string];
if (!collection) throw new Error(`Colección no encontrada: ${collectionSlug}`);

const products = catalog.products.filter((p) => p.coleccionSlugs.includes(collection.slug));
---

<SiteLayout
  pathname={`/coleccion/${collection.slug}`}
  title={collection.title}
  description={collection.descripcion}
>
  <PageHero theme="light" title={collection.title} subtitle={collection.descripcion} />

  <section class="mx-auto max-w-6xl px-4 pb-16">
    <p class="mb-6 text-sm text-gray-500">
      {products.length} {products.length === 1 ? 'producto' : 'productos'} en esta colección
    </p>
    <ProductGrid>
        {products.map((p) => (
          <ProductCard product={p} />
        ))}
    </ProductGrid>
    {
      products.length === 0 && (
        <p class="py-12 text-center text-gray-500">Aún no hay productos en esta colección.</p>
      )
    }
  </section>
</SiteLayout>
