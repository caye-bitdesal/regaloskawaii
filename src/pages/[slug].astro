---
import SiteLayout from '../layouts/SiteLayout.astro';
import PortableText from '../components/PortableText.astro';
import { getCatalog } from '../lib/catalog';

export async function getStaticPaths() {
  const reserved = new Set([
    'aviso-afiliados',
    'categorias',
    'chollos',
    'colecciones',
    'marcas',
    'personajes',
    'sobre-nosotros',
    'producto',
    'coleccion',
    'categoria',
    'marca',
    'personaje',
  ]);
  const catalog = await getCatalog();
  return catalog.pages
    .filter((p) => !reserved.has(p.slug))
    .map((p) => ({
      params: { slug: p.slug },
      props: { pageSlug: p.slug },
    }));
}

const { pageSlug } = Astro.props;
const catalog = await getCatalog();
const page = catalog.pagesBySlug[pageSlug as string];
if (!page) throw new Error(`Página no encontrada: ${pageSlug}`);
---

<SiteLayout pathname={`/${page.slug}`} title={page.title} description={page.title}>
  <section class="catalog shell">
    <h1>{page.title}</h1>
    <div class="about-copy" style="max-width:720px;margin-top:2rem;">
      <PortableText blocks={page.content} />
    </div>
  </section>
</SiteLayout>
