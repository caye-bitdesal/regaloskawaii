---
import SiteLayout from '../layouts/SiteLayout.astro';
import CategoryCard from '../components/CategoryCard.astro';
import RkIcon from '../components/RkIcon.astro';
import { getCatalog } from '../lib/catalog';

const catalog = await getCatalog();
---

<SiteLayout pathname="/categorias" title="Categorías" description="Explora regalos kawaii por categorías.">
  <section class="page-intro categories-intro">
    <div class="shell">
      <span class="eyebrow"><RkIcon name="sparkle" /> Hay algo bonito para cada persona</span>
      <h1>Explora por <em>categorías</em></h1>
      <p>
        Desde pequeños detalles hasta regalos especiales: hemos ordenado todos nuestros hallazgos para
        que encuentres la idea perfecta.
      </p>
    </div>
  </section>

  <section class="categories-section" id="categories">
    <div class="shell">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Explora a tu manera</span>
          <h2>Un universo para cada gusto</h2>
        </div>
        <p>Ideas ordenadas para encontrar justo lo que buscas</p>
      </div>
      <div class="category-showcase">
        {catalog.categories.map((cat, i) => (
          <CategoryCard
            href={`/categoria/${cat.slug}`}
            title={cat.label}
            productCount={cat.productIds.length}
            index={i}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="category-help shell">
    <div>
      <span class="eyebrow">¿No sabes qué elegir?</span>
      <h2>Empieza por nuestros favoritos</h2>
      <p>Una mezcla de regalos virales, detalles útiles y objetos irresistiblemente adorables.</p>
    </div>
    <a class="primary" href="/coleccion/lo-mas-viral">
      Ver lo más viral
      <RkIcon name="arrow" />
    </a>
  </section>
</SiteLayout>
