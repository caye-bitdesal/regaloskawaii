---
import SiteLayout from '../layouts/SiteLayout.astro';
import FilterChips from '../components/FilterChips.astro';
import ProductGrid from '../components/ProductGrid.astro';
import ProductCard from '../components/ProductCard.astro';
import CategoryCard from '../components/CategoryCard.astro';
import RkIcon from '../components/RkIcon.astro';
import { getCatalog } from '../lib/catalog';

const catalog = await getCatalog();
const chips = [
  { id: 'all', label: 'Todos' },
  ...catalog.collections.map((c) => ({ id: c.slug, label: c.title })),
];
const heroImage =
  catalog.products.find((p) => p.imagenUrl)?.imagenUrl ??
  'https://images.unsplash.com/photo-1643014941083-d369d5cd3516?auto=format&fit=crop&w=900&q=85';
const count = catalog.products.length;
---

<SiteLayout
  pathname="/"
  title="Regalos Kawaii — Tu rincón más kawaii"
  description="Encuentra regalos y detalles kawaii con enlaces directos a tiendas externas."
>
  <section class="hero shell">
    <div class="hero-copy">
      <span class="eyebrow"><RkIcon name="sparkle" /> Pequeñas cosas, grandes sonrisas</span>
      <h1>Tu rincón más <em>kawaii</em></h1>
      <p>
        Descubre objetos bonitos que hacen tu día un poquito más feliz. Nosotros los encontramos, tú
        eliges tu favorito.
      </p>
      <a class="primary" href="#catalogo">
        Ver descubrimientos
        <RkIcon name="arrow" />
      </a>
    </div>
    <div class="hero-visual">
      <div class="blob"></div>
      <img src={heroImage} alt="Colección de peluches kawaii en tonos pastel" width="900" height="390" />
      <span class="float-note">100% achuchable</span>
      <span class="doodle one">✦</span>
      <span class="doodle two">♡</span>
    </div>
  </section>

  <section class="catalog shell" id="catalogo">
    <div class="section-heading">
      <div>
        <span class="eyebrow">Explora el catálogo</span>
        <h2>Encuentra tu próximo favorito</h2>
      </div>
      <p>{count} productos seleccionados con mimo</p>
    </div>

    <div class="home-hub" id="home-hub">
      <div class="hub-tabs" role="tablist" aria-label="Agrupar catálogo">
        <button type="button" class="category hub-tab" data-hub-tab="categorias" role="tab">
          Por categoría
        </button>
        <button type="button" class="category hub-tab" data-hub-tab="colecciones" role="tab">
          Por colección
        </button>
        <button type="button" class="category hub-tab" data-hub-tab="marcas" role="tab">
          Por marcas
        </button>
        <button type="button" class="category hub-tab" data-hub-tab="personajes" role="tab">
          Por personajes
        </button>
      </div>

      <div class="hub-panel" data-hub-panel="categorias" role="tabpanel">
        <div class="category-showcase hub-showcase">
          {catalog.categories.map((cat, i) => (
            <CategoryCard
              href={`/categoria/${cat.slug}`}
              title={cat.label}
              productCount={cat.productIds.length}
              index={i}
            />
          ))}
        </div>
      </div>

      <div class="hub-panel" data-hub-panel="colecciones" role="tabpanel" hidden>
        <div class="category-showcase hub-showcase">
          {catalog.collections.map((col, i) => (
            <CategoryCard
              href={`/coleccion/${col.slug}`}
              title={col.title}
              productCount={col.productIds.length}
              index={i}
            />
          ))}
        </div>
      </div>

      <div class="hub-panel" data-hub-panel="marcas" role="tabpanel" hidden>
        <div class="category-showcase hub-showcase">
          {catalog.brands.map((brand, i) => (
            <CategoryCard
              href={`/marca/${brand.slug}`}
              title={brand.label}
              productCount={brand.productIds.length}
              index={i}
            />
          ))}
        </div>
      </div>

      <div class="hub-panel" data-hub-panel="personajes" role="tabpanel" hidden>
        <div class="category-showcase hub-showcase">
          {catalog.characters.map((character, i) => (
            <CategoryCard
              href={`/personaje/${character.slug}`}
              title={character.label}
              productCount={character.productIds.length}
              index={i}
            />
          ))}
        </div>
      </div>
    </div>

    <div class="section-heading" style="margin-top: 3rem;">
      <div>
        <span class="eyebrow">Selección bonita</span>
        <h2>Todos los productos</h2>
      </div>
    </div>
    <FilterChips chips={chips} />
    <ProductGrid>
      {catalog.products.map((p) => (
        <ProductCard product={p} />
      ))}
    </ProductGrid>
  </section>
</SiteLayout>

<script>
  import { initHomeHubTabs } from '../scripts/home-hub-tabs.client';
  initHomeHubTabs();
</script>
