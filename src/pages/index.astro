---
import SiteLayout from '../layouts/SiteLayout.astro';
import FilterChips from '../components/FilterChips.astro';
import ProductGrid from '../components/ProductGrid.astro';
import ProductCard from '../components/ProductCard.astro';
import CategoryCard from '../components/CategoryCard.astro';
import GuiaCard from '../components/GuiaCard.astro';
import RkIcon from '../components/RkIcon.astro';
import { getCollection } from 'astro:content';
import ColeccionGuiasCallout from '../components/ColeccionGuiasCallout.astro';
import { guiasLinkedToPriceCollections } from '../lib/guias/entries';
import { getCatalog, sortProducts } from '../lib/catalog';
import { buildSrcSet, HERO_IMAGE_SIZES, pickDefaultSrc } from '../lib/media/imageVariants';
import { HOME_CRUMB } from '../lib/seo/breadcrumbs';
import { organizationJsonLd, websiteJsonLd } from '../lib/seo/jsonLd';

const catalog = await getCatalog();
const siteOrigin = Astro.site ?? new URL('https://regaloskawaii.es');
const homeDescription =
  'Cosas kawaii para regalar o darte un capricho: squishies, peluches, papelería y más, elegidos uno a uno. Regalos kawaii desde 5 € con enlace a la tienda.';
const products = sortProducts(catalog.products);
const chips = [
  { id: 'all', label: 'Todos' },
  ...catalog.collections.map((c) => ({ id: c.slug, label: c.title })),
];
const heroProduct = products.find((p) => p.imagenUrl);
const heroFallback = '/hero-fallback.jpg';
const heroVariants = heroProduct?.imagenVariants ?? [];
const heroSrc = heroProduct ? pickDefaultSrc(heroVariants, heroProduct.imagenUrl!) : heroFallback;
const heroSrcset = heroProduct ? buildSrcSet(heroVariants) : undefined;
const heroWidth = 900;
const heroHeight =
  heroProduct?.imagenWidth && heroProduct.imagenHeight
    ? Math.round((heroWidth * heroProduct.imagenHeight) / heroProduct.imagenWidth)
    : 450;
const count = products.length;

const guiasHome = guiasLinkedToPriceCollections(await getCollection('guias'));
---

<SiteLayout
  pathname="/"
  title="Regalos Kawaii: cosas kawaii y regalos monos"
  description={homeDescription}
  breadcrumbs={[HOME_CRUMB]}
  jsonLd={[websiteJsonLd(siteOrigin, homeDescription), organizationJsonLd(siteOrigin)]}
>
  {
    heroSrcset && (
      <link
        slot="head"
        rel="preload"
        as="image"
        imagesrcset={heroSrcset}
        imagesizes={HERO_IMAGE_SIZES}
        fetchpriority="high"
      />
    )
  }
  <section class="hero shell">
    <div class="hero-copy">
      <span class="eyebrow"><RkIcon name="sparkle" /> Pequeñas cosas, grandes sonrisas</span>
      <h1>Regalos <em>kawaii</em> y cosas monas para alegrar el día</h1>
      <p>
        Descubre objetos bonitos que hacen tu día un poquito más feliz. Nosotros los encontramos, tú
        eliges tu favorito.
      </p>
      <a class="primary" href="#catalogo">
        Ver descubrimientos
        <RkIcon name="arrow" />
      </a>
    </div>
    <div class="hero-visual">
      <div class="blob"></div>
      <img
        src={heroSrc}
        srcset={heroSrcset}
        sizes={heroSrcset ? HERO_IMAGE_SIZES : undefined}
        alt={heroProduct?.imagenAlt ?? 'Colección de peluches kawaii en tonos pastel'}
        width={heroWidth}
        height={heroHeight}
        fetchpriority="high"
        loading="eager"
        decoding="async"
      />
      <span class="float-note">100% cute</span>
      <span class="doodle one">✦</span>
      <span class="doodle two">♡</span>
    </div>
  </section>

  <section class="home-intro shell" aria-label="Sobre Regalos Kawaii">
    <p>
      En Regalos Kawaii reunimos productos kawaii bonicos: squishies blanditos, peluches de capibara,
      papelería con animalitos, tazas, lámparas, ropa y pequeños detalles en colores pastel. No enlazamos
      productos sin sentido, sino que en Regalos Kawaii hacemos una selección manual: buscamos y elegimos
      cada producto en base a sus valoraciones, por su precio y, sobre todo porque nos gustan y nos
      gustaría que los tuvieras tú. No vendemos directamente: cada producto te lleva a la tienda
      (AliExpress, Amazon y otras), donde compras con sus garantías y plazos de envío. Si compras desde
      nuestros enlaces ganamos una pequeña comisión que nos ayuda a continuar, sin que te cueste nada más.
      Los precios de AliExpress se actualizan cada día.
    </p>
  </section>

  {
    guiasHome.length > 0 && (
      <section class="home-guias shell" aria-labelledby="home-guias-heading">
        <div class="section-heading">
          <div>
            <span class="eyebrow">Inspiración</span>
            <h2 id="home-guias-heading">Guías de regalo</h2>
          </div>
          <a class="primary" href="/guias" style="margin-top: 0;">
            Ver todas
            <RkIcon name="arrow" />
          </a>
        </div>
        <ul class="guia-list home-guias-list">
          {guiasHome.map((guia) => (
            <li>
              <GuiaCard guia={guia} showDate />
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="catalog shell" id="catalogo">
    <div class="section-heading">
      <div>
        <span class="eyebrow">Explora el catálogo</span>
        <h2>Encuentra tu próximo favorito</h2>
      </div>
      <p>{count} productos seleccionados con mimo</p>
    </div>

    <div class="home-hub" id="home-hub">
      <div class="hub-tabs" role="tablist" aria-label="Agrupar catálogo">
        <button type="button" class="category hub-tab" data-hub-tab="categorias" role="tab">
          Por categoría
        </button>
        <button type="button" class="category hub-tab" data-hub-tab="colecciones" role="tab">
          Por colección
        </button>
      </div>

      <div class="hub-panel" data-hub-panel="categorias" role="tabpanel">
        <div class="category-showcase hub-showcase">
          {catalog.categories.map((cat, i) => (
            <CategoryCard
              href={`/categoria/${cat.slug}`}
              title={cat.label}
              productCount={cat.productIds.length}
              index={i}
            />
          ))}
        </div>
      </div>

      <div class="hub-panel" data-hub-panel="colecciones" role="tabpanel" hidden>
        <div class="category-showcase hub-showcase">
          {catalog.collections.map((col, i) => (
            <CategoryCard
              href={`/coleccion/${col.slug}`}
              title={col.title}
              productCount={col.productIds.length}
              index={i}
            />
          ))}
        </div>
        {guiasHome.length > 0 && <ColeccionGuiasCallout guias={guiasHome} class="home-hub-guias-callout" />}
      </div>
    </div>

    <p class="home-taxonomy-note">
      <a href="/categorias">Marcas, personajes y tiendas</a>
      están en Categorías.
    </p>

    <div class="section-heading" style="margin-top: 3rem;">
      <div>
        <span class="eyebrow">Selección bonita</span>
        <h2>Todos los productos</h2>
      </div>
    </div>
    <FilterChips chips={chips} />
    <ProductGrid>
      {products.map((p) => (
        <ProductCard product={p} />
      ))}
    </ProductGrid>
  </section>
</SiteLayout>

<script>
  import { initHomeHubTabs } from '../scripts/home-hub-tabs.client';
  initHomeHubTabs();
</script>
