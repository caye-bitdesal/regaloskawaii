---
import SiteLayout from '../layouts/SiteLayout.astro';
import FilterChips from '../components/FilterChips.astro';
import ProductGrid from '../components/ProductGrid.astro';
import ProductCard from '../components/ProductCard.astro';
import CategoryCard from '../components/CategoryCard.astro';
import RkIcon from '../components/RkIcon.astro';
import { getCatalog, sortProducts } from '../lib/catalog';
import { buildSrcSet, HERO_IMAGE_SIZES, pickDefaultSrc } from '../lib/media/imageVariants';
import { HOME_CRUMB } from '../lib/seo/breadcrumbs';
import { organizationJsonLd, websiteJsonLd } from '../lib/seo/jsonLd';

const catalog = await getCatalog();
const siteOrigin = Astro.site ?? new URL('https://regaloskawaii.es');
const homeDescription =
  'Encuentra regalos y detalles kawaii con enlaces directos a tiendas externas.';
const products = sortProducts(catalog.products);
const chips = [
  { id: 'all', label: 'Todos' },
  ...catalog.collections.map((c) => ({ id: c.slug, label: c.title })),
];
const heroProduct = products.find((p) => p.imagenUrl);
const heroFallback = '/capibara-404.webp';
const heroVariants = heroProduct?.imagenVariants ?? [];
const heroSrc = heroProduct ? pickDefaultSrc(heroVariants, heroProduct.imagenUrl!) : heroFallback;
const heroSrcset = heroProduct ? buildSrcSet(heroVariants) : undefined;
const heroWidth = 900;
const heroHeight =
  heroProduct?.imagenWidth && heroProduct.imagenHeight
    ? Math.round((heroWidth * heroProduct.imagenHeight) / heroProduct.imagenWidth)
    : 620;
const count = products.length;
---

<SiteLayout
  pathname="/"
  title="Regalos Kawaii — Tu rincón más kawaii"
  description={homeDescription}
  breadcrumbs={[HOME_CRUMB]}
  jsonLd={[websiteJsonLd(siteOrigin, homeDescription), organizationJsonLd(siteOrigin)]}
>
  {
    heroSrcset && (
      <link
        slot="head"
        rel="preload"
        as="image"
        imagesrcset={heroSrcset}
        imagesizes={HERO_IMAGE_SIZES}
        fetchpriority="high"
      />
    )
  }
  <section class="hero shell">
    <div class="hero-copy">
      <span class="eyebrow"><RkIcon name="sparkle" /> Pequeñas cosas, grandes sonrisas</span>
      <h1>Tu rincón más <em>kawaii</em></h1>
      <p>
        Descubre objetos bonitos que hacen tu día un poquito más feliz. Nosotros los encontramos, tú
        eliges tu favorito.
      </p>
      <a class="primary" href="#catalogo">
        Ver descubrimientos
        <RkIcon name="arrow" />
      </a>
    </div>
    <div class="hero-visual">
      <div class="blob"></div>
      <img
        src={heroSrc}
        srcset={heroSrcset}
        sizes={heroSrcset ? HERO_IMAGE_SIZES : undefined}
        alt={heroProduct?.imagenAlt ?? 'Colección de peluches kawaii en tonos pastel'}
        width={heroWidth}
        height={heroHeight}
        fetchpriority="high"
        loading="eager"
        decoding="async"
      />
      <span class="float-note">100% achuchable</span>
      <span class="doodle one">✦</span>
      <span class="doodle two">♡</span>
    </div>
  </section>

  <section class="catalog shell" id="catalogo">
    <div class="section-heading">
      <div>
        <span class="eyebrow">Explora el catálogo</span>
        <h2>Encuentra tu próximo favorito</h2>
      </div>
      <p>{count} productos seleccionados con mimo</p>
    </div>

    <div class="home-hub" id="home-hub">
      <div class="hub-tabs" role="tablist" aria-label="Agrupar catálogo">
        <button type="button" class="category hub-tab" data-hub-tab="categorias" role="tab">
          Por categoría
        </button>
        <button type="button" class="category hub-tab" data-hub-tab="colecciones" role="tab">
          Por colección
        </button>
        <button type="button" class="category hub-tab" data-hub-tab="marcas" role="tab">
          Por marcas
        </button>
        <button type="button" class="category hub-tab" data-hub-tab="personajes" role="tab">
          Por personajes
        </button>
        <button type="button" class="category hub-tab" data-hub-tab="tiendas" role="tab">
          Por tiendas
        </button>
      </div>

      <div class="hub-panel" data-hub-panel="categorias" role="tabpanel">
        <div class="category-showcase hub-showcase">
          {catalog.categories.map((cat, i) => (
            <CategoryCard
              href={`/categoria/${cat.slug}`}
              title={cat.label}
              productCount={cat.productIds.length}
              index={i}
            />
          ))}
        </div>
      </div>

      <div class="hub-panel" data-hub-panel="colecciones" role="tabpanel" hidden>
        <div class="category-showcase hub-showcase">
          {catalog.collections.map((col, i) => (
            <CategoryCard
              href={`/coleccion/${col.slug}`}
              title={col.title}
              productCount={col.productIds.length}
              index={i}
            />
          ))}
        </div>
      </div>

      <div class="hub-panel" data-hub-panel="marcas" role="tabpanel" hidden>
        <div class="category-showcase hub-showcase">
          {catalog.brands.map((brand, i) => (
            <CategoryCard
              href={`/marca/${brand.slug}`}
              title={brand.label}
              productCount={brand.productIds.length}
              index={i}
            />
          ))}
        </div>
      </div>

      <div class="hub-panel" data-hub-panel="personajes" role="tabpanel" hidden>
        <div class="category-showcase hub-showcase">
          {catalog.characters.map((character, i) => (
            <CategoryCard
              href={`/personaje/${character.slug}`}
              title={character.label}
              productCount={character.productIds.length}
              index={i}
            />
          ))}
        </div>
      </div>

      <div class="hub-panel" data-hub-panel="tiendas" role="tabpanel" hidden>
        <div class="category-showcase hub-showcase">
          {catalog.stores.map((store, i) => (
            <CategoryCard
              href={`/tienda/${store.slug}`}
              title={store.label}
              productCount={store.productIds.length}
              index={i}
            />
          ))}
        </div>
      </div>
    </div>

    <div class="section-heading" style="margin-top: 3rem;">
      <div>
        <span class="eyebrow">Selección bonita</span>
        <h2>Todos los productos</h2>
      </div>
    </div>
    <FilterChips chips={chips} />
    <ProductGrid>
      {products.map((p) => (
        <ProductCard product={p} />
      ))}
    </ProductGrid>
  </section>
</SiteLayout>

<script>
  import { initHomeHubTabs } from '../scripts/home-hub-tabs.client';
  initHomeHubTabs();
</script>
