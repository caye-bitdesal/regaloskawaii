---
import type { CatalogProduct } from '../lib/emdash/types';
import ProductCard from './ProductCard.astro';
import ProductGrid from './ProductGrid.astro';

interface Props {
  products: CatalogProduct[];
}

const { products } = Astro.props;
---

{
  products.length > 0 && (
    <section class="related shell">
      <div class="section-heading">
        <div>
          <span class="eyebrow">También te gustará</span>
          <h2>Más cositas bonitas</h2>
        </div>
      </div>
      <ProductGrid class="three">
        {products.map((p) => (
          <ProductCard product={p} />
        ))}
      </ProductGrid>
    </section>
  )
}
