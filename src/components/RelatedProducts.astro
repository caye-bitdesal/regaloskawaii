---
import type { CatalogProduct } from '../lib/emdash/types';
import ProductCard from './ProductCard.astro';

interface Props {
  products: CatalogProduct[];
}

const { products } = Astro.props;
---

{
  products.length > 0 && (
    <section class="mt-16 border-t border-gray-100 pt-12">
      <p class="text-xs font-semibold tracking-wide text-rk-pink uppercase">También te gustará</p>
      <h2 class="mt-2 text-2xl font-bold">Más cositas bonitas</h2>
      <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {products.map((p) => (
          <ProductCard product={p} />
        ))}
      </div>
    </section>
  )
}
