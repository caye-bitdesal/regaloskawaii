---
import type { CatalogCollection } from '../lib/emdash/types';
import { collectionAbbrev } from '../lib/emdash/helpers';
import RkIcon from './RkIcon.astro';

interface Props {
  collection: CatalogCollection;
  index: number;
}

const { collection, index } = Astro.props;
const abbrev = collectionAbbrev(collection.title);
const tone = (index % 6) + 1;
const count = collection.productIds.length;

const PLURAL_IDEITAS = [
  (n: number) => `✨ ¡${n} ideítas por aquí!`,
  (n: number) => `🌸 ${n} ideas esperándote`,
  (n: number) => `🍡 ¡Hay ${n} ideas monísimas!`,
  (n: number) => `💖 ${n} ideítas viviendo aquí`,
];

function categoryCountLabel(n: number, variantIndex: number): string {
  if (n <= 0) return '🥺 Aquí no vive ninguna ideíta todavía...';
  if (n === 1) return '🌟 ¡Una ideíta solita te espera!';
  const pick = PLURAL_IDEITAS[variantIndex % PLURAL_IDEITAS.length];
  return pick(n);
}

const countLabel = categoryCountLabel(count, index);
---

<a href={`/coleccion/${collection.slug}`} class={`category-tile tone-${tone}`}>
  <span class="category-mark">{abbrev}</span>
  <span class="category-info">
    <strong>{collection.title}</strong>
    <small>{countLabel}</small>
  </span>
  <span class="category-arrow"><RkIcon name="arrow" /></span>
</a>
