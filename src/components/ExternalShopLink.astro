---
interface Props {
  href: string;
  label: string;
  variant?: 'button' | 'text';
}

const { href, label, variant = 'text' } = Astro.props;
---

{
  variant === 'button' ? (
    <a
      href={href}
      target="_blank"
      rel="sponsored nofollow noopener"
      class="inline-flex w-full items-center justify-center gap-2 rounded-2xl bg-rk-pink px-6 py-4 text-center font-semibold text-white transition hover:bg-rk-pink-dark"
    >
      {label}
      <span aria-hidden="true">↗</span>
    </a>
  ) : (
    <a
      href={href}
      target="_blank"
      rel="sponsored nofollow noopener"
      class="inline-flex items-center gap-1 text-sm font-medium text-gray-600 transition hover:text-rk-pink"
    >
      {label}
      <span aria-hidden="true">↗</span>
    </a>
  )
}
