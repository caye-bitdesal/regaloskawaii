---
interface Props {
  pathname?: string;
}

const { pathname = '/' } = Astro.props;

const nav = [
  { href: '/', label: 'Catálogo' },
  { href: '/categorias', label: 'Categorías' },
  { href: '/chollos', label: 'Chollos', highlight: true },
  { href: '/sobre-nosotros', label: 'Sobre nosotros' },
];

function isActive(href: string): boolean {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
}
---

<header class="sticky top-0 z-50 border-b border-gray-100 bg-white/95 backdrop-blur">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-4 px-4 py-3 md:py-4">
    <a href="/" class="flex shrink-0 items-center gap-2 no-underline">
      <span
        class="flex h-9 w-9 items-center justify-center rounded-full bg-rk-pink text-sm font-bold text-white"
        aria-hidden="true">K</span
      >
      <span class="text-lg font-bold text-rk-footer">Regalos Kawaii</span>
    </a>

    <nav class="order-3 flex w-full flex-wrap items-center justify-center gap-1 md:order-2 md:w-auto md:flex-1 md:justify-center" aria-label="Principal">
      {
        nav.map((item) => {
          const active = isActive(item.href);
          const chollosPill = item.highlight && active;
          return (
            <a
              href={item.href}
              class:list={[
                'rounded-full px-3 py-1.5 text-sm font-medium transition',
                chollosPill
                  ? 'bg-rk-yellow-accent/80 text-rk-footer'
                  : active
                    ? 'text-rk-pink'
                    : 'text-gray-600 hover:text-rk-pink',
              ]}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <div class="order-2 ml-auto md:order-3 md:ml-0" id="site-search-root">
      <label class="relative block">
        <span class="sr-only">Buscar</span>
        <input
          type="search"
          id="site-search-input"
          placeholder="Buscar cositas…"
          autocomplete="off"
          class="w-44 rounded-full border border-gray-200 bg-gray-50 py-2 pr-3 pl-9 text-sm outline-none focus:border-rk-pink md:w-52"
        />
        <svg
          class="pointer-events-none absolute top-1/2 left-3 h-4 w-4 -translate-y-1/2 text-gray-400"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M21 21l-4.35-4.35M11 18a7 7 0 100-14 7 7 0 000 14z"></path>
        </svg>
      </label>
      <ul
        id="site-search-results"
        class="absolute z-50 mt-1 hidden max-h-64 w-52 overflow-auto rounded-xl border border-gray-100 bg-white py-1 shadow-lg"
        role="listbox"
      />
    </div>
  </div>
</header>

<script>
  import { initSiteSearch } from '../scripts/site-search.client';
  initSiteSearch();
</script>
