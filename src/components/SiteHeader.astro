---
import BrandMark from './BrandMark.astro';
import RkIcon from './RkIcon.astro';

interface Props {
  pathname?: string;
  hideSearch?: boolean;
}

const { pathname = '/', hideSearch = false } = Astro.props;

const nav = [
  { href: '/', label: 'Catálogo' },
  { href: '/categorias', label: 'Categorías' },
  { href: '/chollos', label: 'Chollos', deal: true },
  { href: '/sobre-nosotros', label: 'Sobre nosotros' },
];

function isActive(href: string): boolean {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
}
---

<header>
  <div class="nav shell">
    <a href="/" class="brand">
      <BrandMark />
      <strong>Regalos Kawaii</strong>
    </a>
    <nav aria-label="Principal">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={[item.deal && 'deal-nav', isActive(item.href) && !item.deal && 'is-active']}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    {
      !hideSearch && (
        <div id="site-search-root">
          <label class="search">
            <RkIcon name="search" />
            <span class="sr-only">Buscar</span>
            <input
              type="search"
              id="site-search-input"
              placeholder="Buscar cositas..."
              autocomplete="off"
            />
          </label>
          <ul id="site-search-results" class="hidden" role="listbox" />
        </div>
      )
    }
  </div>
</header>

<style>
  .nav nav a.is-active {
    color: #ec5b87;
  }
</style>

<script>
  import { initSiteSearch } from '../scripts/site-search.client';
  initSiteSearch();
</script>
