---
import type { CatalogProduct } from '../lib/emdash/types';
import { formatPriceEur } from '../lib/emdash/helpers';
import ExternalShopLink from './ExternalShopLink.astro';
import PortableText from './PortableText.astro';

interface Props {
  product: CatalogProduct;
}

const { product } = Astro.props;
const price = formatPriceEur(product.precioRef);
const label = product.coleccionTitles[0]?.toUpperCase() ?? 'KAWAII';
const bullets = [
  'Elegido por su diseño especial',
  'Ideal para regalar o darte un capricho',
  'Compra gestionada por la tienda externa',
];
---

<div>
  <p class="text-xs font-semibold tracking-wide text-rk-pink">{label}</p>
  <h1 class="mt-2 text-3xl font-bold">{product.title}</h1>
  {
    price && (
      <p class="mt-4">
        <span class="text-3xl font-bold text-rk-pink">{price}</span>
        <span class="ml-2 text-sm text-gray-500">Precio orientativo</span>
      </p>
    )
  }
  <p class="mt-4 text-gray-600">{product.resumen}</p>
  {
    product.descripcion && product.descripcion.length > 0 && (
      <div class="mt-4">
        <PortableText blocks={product.descripcion} />
      </div>
    )
  }
  <ul class="mt-6 space-y-2 rounded-2xl bg-pink-50 p-4 text-sm">
    {
      bullets.map((b) => (
        <li class="flex gap-2">
          <span class="text-rk-pink" aria-hidden="true">
            ♥
          </span>
          {b}
        </li>
      ))
    }
  </ul>
  <div class="mt-8">
    <ExternalShopLink
      href={product.affiliateUrl}
      label={`Visitar producto en ${product.tiendaTitle.replace(' España', '')}`}
      variant="button"
    />
    <p class="mt-3 text-xs text-gray-500">
      Enlace de afiliado. Regalos Kawaii no vende ni gestiona pedidos.
    </p>
  </div>
</div>
