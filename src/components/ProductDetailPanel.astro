---
import type { CatalogProduct } from '../lib/emdash/types';
import { formatPriceEur } from '../lib/emdash/helpers';
import RkIcon from './RkIcon.astro';
import PortableText from './PortableText.astro';

interface Props {
  product: CatalogProduct;
}

const { product } = Astro.props;
const price = formatPriceEur(product.precioRef);
const label = product.coleccionTitles[0] ?? 'Kawaii';
const shopLabel = product.tiendaTitle.replace(' España', '');
const bullets = [
  'Elegido por su diseño especial',
  'Ideal para regalar o darte un capricho',
  'Compra gestionada por la tienda externa',
];
---

<div class="detail-copy">
  <span class="eyebrow">{label}</span>
  <h1>{product.title}</h1>
  {
    price && (
      <div class="detail-price">
        {price}
        <small>Precio orientativo</small>
      </div>
    )
  }
  <p>{product.resumen}</p>
  {
    product.descripcion && product.descripcion.length > 0 && (
      <div>
        <PortableText blocks={product.descripcion} />
      </div>
    )
  }
  <ul>
    {bullets.map((b) => (
      <li>{b}</li>
    ))}
  </ul>
  {
    product.autenticidadNoGarantizada && (
      <p class="unverified-note" role="note">
        <strong>Producto no oficial.</strong> No podemos garantizar su autenticidad: puede no ser un
        artículo con licencia de la marca o del personaje. Revisa la ficha y las opiniones del vendedor
        antes de comprar.
      </p>
    )
  }
  <a class="primary wide" href={product.affiliateUrl} target="_blank" rel="sponsored nofollow noopener">
    Visitar producto en {shopLabel}
    <RkIcon name="external" />
  </a>
  <p class="affiliate">
    Al visitar la tienda saldrás de Regalos Kawaii. No vendemos directamente este producto.
  </p>
</div>
