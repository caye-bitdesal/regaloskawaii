---
import type { CatalogProduct } from '../lib/emdash/types';
import { formatPriceEur } from '../lib/emdash/helpers';
import RkIcon from './RkIcon.astro';

interface Props {
  product: CatalogProduct;
  variant?: 'default' | 'deal';
  showDealBadge?: boolean;
  dealIndex?: number;
}

const { product, variant = 'default', showDealBadge = true, dealIndex = 0 } = Astro.props;

const label = product.coleccionTitles[0] ?? 'Kawaii';
const price = formatPriceEur(product.precioRef);
const badge =
  product.coleccionSlugs.includes('lo-mas-viral')
    ? 'Viral'
    : product.destacado
      ? 'Favorito'
      : undefined;

const isDeal = variant === 'deal';
const discountPct = 15 + ((dealIndex + product.slug.length) % 20);
const shopLabel = product.tiendaTitle.replace(' España', '');
---

<article
  class="product-card"
  data-product-slug={product.slug}
  data-colecciones={product.coleccionSlugs.join(',')}
  data-title={product.title}
>
  <a class="image-button" href={`/producto/${product.slug}`}>
    {
      product.imagenUrl ? (
        <img src={product.imagenUrl} alt={product.imagenAlt ?? product.title} loading="lazy" width="400" height="250" />
      ) : (
        <span class="meta" style="position:absolute;inset:0;display:grid;place-items:center;">Sin imagen</span>
      )
    }
    {
      isDeal && showDealBadge ? (
        <span class="badge discount">-{discountPct}%</span>
      ) : (
        badge && <span class="badge">{badge}</span>
      )
    }
    <span class="heart">
      <button
        type="button"
        class="favorite-btn"
        data-favorite-slug={product.slug}
        aria-label="Añadir a favoritos"
      >
        <RkIcon name="heart" />
      </button>
    </span>
  </a>
  <div class="card-copy">
    <span class="meta">{label}</span>
    <a class="product-title" href={`/producto/${product.slug}`}>{product.title}</a>
    <div class="card-bottom">
      <div class="price-stack">
        {
          isDeal && price && product.precioRef ? (
            <>
              <del>{formatPriceEur(product.precioRef * 1.28)}</del>
              <strong>{price}</strong>
            </>
          ) : (
            price && <strong>{price}</strong>
          )
        }
      </div>
      <a class="round" href={`/producto/${product.slug}`} aria-label={`Ver ${product.title}`}>
        <RkIcon name="arrow" />
      </a>
    </div>
    <a class="shop-link" href={product.affiliateUrl} target="_blank" rel="sponsored nofollow noopener">
      Ver en {shopLabel}
      <RkIcon name="external" />
    </a>
  </div>
</article>

<script>
  import { initFavoriteButtons } from '../scripts/favorites.client';
  initFavoriteButtons();
</script>
