---
import type { CatalogProduct } from '../lib/emdash/types';
import { formatPriceEur } from '../lib/emdash/helpers';
import OfficialProductBadge from './OfficialProductBadge.astro';
import ResponsiveProductImage from './ResponsiveProductImage.astro';
import RkIcon from './RkIcon.astro';

interface Props {
  product: CatalogProduct;
}

const { product } = Astro.props;

const label = product.coleccionTitles[0] ?? 'Kawaii';
const price = formatPriceEur(product.precioRef);
const badge =
  product.coleccionSlugs.includes('lo-mas-viral')
    ? 'Viral'
    : product.destacado
      ? 'Favorito'
      : undefined;

const shopLabel = product.tiendaTitle.replace(' España', '');
const productHref = `/producto/${product.slug}`;
---

<article
  class="product-card"
  data-product-slug={product.slug}
  data-tienda={product.tiendaId}
  data-colecciones={product.coleccionSlugs.join(',')}
  data-title={product.title}
>
  <a class="card-product-link" href={productHref}>
    <div class="image-button">
      {
        product.imagenUrl ? (
          <ResponsiveProductImage product={product} layout="card" />
        ) : (
          <span class="meta image-placeholder">Sin imagen</span>
        )
      }
      {
        product.descuento ? (
          <span class="badge discount">-{product.descuento.porcentaje}%</span>
        ) : (
          badge && <span class="badge">{badge}</span>
        )
      }
    </div>
    <div class="card-copy">
      <span class="meta">{label}</span>
      <span class="product-title">
        {product.productoOficial && <OfficialProductBadge />}
        <span>{product.title}</span>
      </span>
      <div class="card-bottom">
        <div class="price-stack">
          {
            price && product.descuento ? (
              <>
                <del title="Precio más bajo de los 30 días anteriores">
                  {formatPriceEur(product.descuento.precioAnterior)}
                </del>
                <strong>{price}</strong>
              </>
            ) : (
              price && <strong>{price}</strong>
            )
          }
        </div>
        <span class="round" aria-hidden="true">
          <RkIcon name="arrow" />
        </span>
      </div>
    </div>
  </a>
  <span class="heart">
    <button
      type="button"
      class="favorite-btn"
      data-favorite-slug={product.slug}
      aria-label="Añadir a favoritos"
    >
      <RkIcon name="heart" />
    </button>
  </span>
  <a class="shop-link" href={product.affiliateUrl} target="_blank" rel="sponsored nofollow noopener">
    Ver en {shopLabel}
    <RkIcon name="external" />
  </a>
</article>

<script>
  import { initFavoriteButtons } from '../scripts/favorites.client';
  initFavoriteButtons();
</script>
