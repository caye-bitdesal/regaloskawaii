---
interface Chip {
  id: string;
  label: string;
}

interface Props {
  chips: Chip[];
  gridId?: string;
}

const { chips, gridId = 'product-grid' } = Astro.props;
---

<div class="category-row" id="filter-chips" data-grid-id={gridId}>
  {
    chips.map((chip, i) => (
      <button type="button" data-filter={chip.id} class:list={['category', i === 0 && 'active']}>
        {chip.label}
      </button>
    ))
  }
</div>

<script>
  import { initFilterChips } from '../scripts/filter-chips.client';
  initFilterChips();
</script>
