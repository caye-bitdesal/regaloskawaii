---
interface Chip {
  id: string;
  label: string;
}

interface Props {
  chips: Chip[];
  gridId?: string;
  /** Refleja el filtro en `?coleccion=` (páginas de categoría). */
  urlSync?: boolean;
  /** Filtra `.collection-block` por `data-collection` en lugar de `.product-card`. */
  collectionBlocks?: boolean;
  /** Filtra `.product-card` por `data-tienda` (id de tienda). */
  shopFilter?: boolean;
}

const {
  chips,
  gridId = 'product-grid',
  urlSync = false,
  collectionBlocks = false,
  shopFilter = false,
} = Astro.props;
---

<div
  class="category-row"
  id="filter-chips"
  data-grid-id={gridId}
  data-url-sync={urlSync ? 'true' : undefined}
  data-collection-blocks={collectionBlocks ? 'true' : undefined}
  data-shop-filter={shopFilter ? 'true' : undefined}
>
  {
    chips.map((chip, i) => (
      <button type="button" data-filter={chip.id} class:list={['category', i === 0 && 'active']}>
        {chip.label}
      </button>
    ))
  }
</div>

<script>
  import { initCategoryCollectionFilter } from '../scripts/category-collection-filter.client';
  import { initFilterChips } from '../scripts/filter-chips.client';

  const root = document.getElementById('filter-chips');
  if (root?.dataset.urlSync === 'true') initCategoryCollectionFilter();
  else initFilterChips();
</script>
