---
interface Chip {
  id: string;
  label: string;
}

interface Props {
  chips: Chip[];
  gridId?: string;
  /** Refleja el filtro en `?coleccion=` (páginas de categoría). */
  urlSync?: boolean;
}

const { chips, gridId = 'product-grid', urlSync = false } = Astro.props;
---

<div class="category-row" id="filter-chips" data-grid-id={gridId}>
  {
    chips.map((chip, i) => (
      <button type="button" data-filter={chip.id} class:list={['category', i === 0 && 'active']}>
        {chip.label}
      </button>
    ))
  }
</div>

<script define:vars={{ urlSync }}>
  if (urlSync) {
    import('../scripts/category-collection-filter.client').then((m) =>
      m.initCategoryCollectionFilter(),
    );
  } else {
    import('../scripts/filter-chips.client').then((m) => m.initFilterChips());
  }
</script>
