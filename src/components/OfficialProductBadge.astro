---
interface Props {
  variant?: 'card' | 'detail';
}

const { variant = 'card' } = Astro.props;
const title = 'Producto que hemos verificado como original o con licencia de marca';
const size = variant === 'detail' ? 36 : 22;
---

<span
  class:list={['official-badge', variant === 'detail' && 'official-badge--detail']}
  title={title}
  role="img"
  aria-label="Producto oficial"
>
  <img
    src="/icons/badge-oficial.png"
    alt=""
    width={size}
    height={size}
    loading="lazy"
    decoding="async"
  />
</span>
