---
import BrandMark from './BrandMark.astro';
---

<footer>
  <div class="shell footer-inner">
    <div>
      <div class="brand light">
        <BrandMark />
        <strong>Regalos Kawaii</strong>
      </div>
      <p>Una selección de cosas bonitas encontradas por internet.</p>
    </div>
    <div class="footer-meta">
      <p>No somos una tienda. Solo compartimos hallazgos kawaii.</p>
      <a href="/aviso-afiliados">¿Cómo nos ayudas?</a>
      <nav class="footer-legal" aria-label="Información legal">
        <a href="/aviso-legal">Aviso legal</a>
        <a href="/privacidad">Privacidad</a>
        <a href="/cookies">Cookies</a>
        <a
          class="footer-credit"
          href="https://bitdesal.es"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Diseño web Bitdesal (se abre en una pestaña nueva)"
        >
          Diseño web{' '}
          <img
            class="footer-credit-logo"
            src="/bitdesal-logo.png"
            width="32"
            height="32"
            alt=""
            loading="lazy"
            decoding="async"
          />{' '}
          Bitdesal
        </a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .footer-legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.5rem;
    align-items: center;
    margin-top: 0.75rem;
    font-size: 13px;
    opacity: 0.92;
  }

  .footer-legal a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 8px 10px;
    color: #d5c8d1;
  }

  .footer-credit {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .footer-credit-logo {
    display: block;
    height: 1.1em;
    width: auto;
    flex-shrink: 0;
    border-radius: 4px;
  }
</style>
