---
const steps = [
  {
    n: '01',
    title: 'Buscamos',
    text: 'Exploramos tiendas y marketplaces en busca de productos especiales.',
  },
  {
    n: '02',
    title: 'Seleccionamos',
    text: 'Elegimos propuestas bonitas, útiles y con personalidad propia.',
  },
  {
    n: '03',
    title: 'Te conectamos',
    text: 'Te llevamos a la tienda externa para consultar o comprar el producto.',
  },
];
---

<section class="how-it-works">
  <div class="shell">
    <div class="section-heading">
      <div>
        <span class="eyebrow">Así de sencillo</span>
        <h2>Cómo funciona Regalos Kawaii</h2>
      </div>
    </div>
    <div class="steps">
      {
        steps.map((step) => (
          <div>
            <span>{step.n}</span>
            <strong>{step.title}</strong>
            <p>{step.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
